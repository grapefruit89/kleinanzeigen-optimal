{
  "manifest_version": 3,
  "name": "Kleinanzeigen Rental Analyzer",
  "version": "2.0.1",
  "description": "Modulares Analyse-Tool & UI-Verbesserungen fuer Kleinanzeigen.de",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "downloads",
    "sidePanel",
    "activeTab",
    "declarativeNetRequest"
  ],
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "host_permissions": [
    "https://www.kleinanzeigen.de/*",
    "https://api.kleinanzeigen.de/*"
  ],
  "background": {
    "service_worker": "core/background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    },
    "default_title": "KA Analyzer öffnen (SidePanel rechts)"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.kleinanzeigen.de/*"],
      "js": [
        "core/FeatureManager.js",
        "core/safeHtml.js",
        "core/kaApi.js",
        "core/kaApiNormalize.js",
        "core/anchors.js",
        "core/ad.js",
        "core/source.js",
        "features/RentalAnalyzer/parser.js",
        "features/RentalAnalyzer/stats.js",
        "features/RentalAnalyzer/ui.js",
        "features/RentalAnalyzer/enrich.js",
        "features/RentalAnalyzer/detail.js",
        "features/RentalAnalyzer/index.js",
        "features/WasdNavigation/index.js",
        "features/UiCleaner/index.js",
        "features/HighResZoom/index.js",
        "features/SortSaver/index.js",
        "features/WidescreenLayout/index.js",
        "features/AutoShowMore/index.js",
        "features/CleanHomepage/index.js",
        "features/ProAdManager/index.js",
        "features/DataExport/index.js",
        "features/McpBridge/index.js",
        "features/BadgeRemover/index.js",
        "features/AdRecorder/index.js",
        "features/index.js"
      ],
      "css": [
        "features/RentalAnalyzer/style.css",
        "features/UiCleaner/style.css",
        "features/WidescreenLayout/style.css",
        "features/HighResZoom/style.css",
        "features/CleanHomepage/style.css",
        "features/ProAdManager/style.css",
        "features/DataExport/style.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.kleinanzeigen.de/*"],
      "js": ["core/Storage.js", "features/InPageMenu/index.js"],
      "css": ["features/InPageMenu/style.css"],
      "run_at": "document_start"
    }
  ]
}
